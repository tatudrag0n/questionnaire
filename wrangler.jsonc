{
  "name": "questionnaire",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f82c647c-2004-446c-8828-fbb10e1c8752"
    }
  ],
  "vars": {
    "SURVEY_NOTICE": "このアンケートは探究活動のために実施します。\n目的：熊谷高校の授業でのICTの使われ方、学習・生活に関する経験と自己評価の関連、情報活用・生成AIと、学校や社会に望まれる支援・ルールを探究すること。\n管理者：【島田龍也】\n問い合わせ先：【shimada.tatsuya.dc@st.spec.ed.jp】\n結果は個人を特定しない集計の形で発表し、保管期限後に回答データと書き出した個別データを削除します。\n成績評価や個人の成績把握を目的とする調査ではありません。",
    "SURVEY_OPEN": "true"
  }
}
