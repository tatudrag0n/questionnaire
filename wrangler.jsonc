{
  "name": "questionnaire",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f82c647c-2004-446c-8828-fbb10e1c8752"
    }
  ],
  "vars": {
    "SURVEY_NOTICE": "このアンケートは探究活動のために実施します。\n目的：ICT・生成AIの利用と、学習・生活・自己申告の成績との関連を調べること。\n管理者：【島田龍也】\n問い合わせ先：【shimada.tatsuya.dc@st.spec.ed.jp】\n結果は個人を特定しない集計の形で発表し、保管期限後に回答データと書き出した個別データを削除します。\n学年順位などの成績情報は任意です。",
    "SURVEY_OPEN": "true"
  }
}
