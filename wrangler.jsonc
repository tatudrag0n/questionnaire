{
  "name": "questionnaire",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f82c647c-2004-446c-8828-fbb10e1c8752"
    }
  ]
}
