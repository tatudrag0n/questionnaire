{
  "name": "questionnaire",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f82c647c-2004-446c-8828-fbb10e1c8752"
    }
  ],
  "vars": {
    "SURVEY_NOTICE": "熊谷高校の生徒による探究活動です。学校の公式調査ではありません。\n実施者・回答データの管理者：島田龍也（問い合わせ：shimada.tatsuya.dc@st.spec.ed.jp）\n回答データを見られるのは実施者本人だけで、発表では個人を特定しない集計結果のみを共有します。保管期限は受付終了日から1年間です。",
    "SURVEY_OPEN": "true"
  }
}
